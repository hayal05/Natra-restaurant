{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Explicit application command access for the bundled main window only. No remote or window creation permissions.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-is-initialized",
    "allow-initialize-admin",
    "allow-login",
    "allow-logout",
    "allow-create-waiter",
    "allow-list-waiters",
    "allow-set-waiter-active",
    "allow-list-waiter-receivables",
    "allow-list-waiter-receivable-sales",
    "allow-list-waiter-receivable-sale-items",
    "allow-settle-waiter",
    "allow-create-category",
    "allow-list-categories",
    "allow-create-item",
    "allow-list-items",
    "allow-set-item-active",
    "allow-update-item-pricing",
    "allow-create-raw-material",
    "allow-list-raw-materials",
    "allow-record-purchase",
    "allow-list-purchases",
    "allow-raw-material-total-cost",
    "allow-get-material-month-closing",
    "allow-save-material-month-draft",
    "allow-close-material-month",
    "allow-reopen-material-month",
    "allow-create-expense",
    "allow-list-expenses",
    "allow-calculate-profit",
    "allow-checkout",
    "allow-list-sales",
    "allow-reverse-sale",
    "allow-monthly-report",
    "allow-monthly-estimated-profit",
    "allow-product-performance",
    "allow-sales-mix",
    "allow-cash-flow-by-year",
    "allow-dashboard-summary",
    "allow-cloud-sync-configuration",
    "allow-cloud-sync-credentials",
    "allow-cloud-sync-begin",
    "allow-cloud-sync-pending",
    "allow-cloud-sync-acknowledge",
    "allow-cloud-sync-cursor",
    "allow-cloud-sync-apply",
    "allow-cloud-sync-end",
    "allow-get-settings",
    "allow-get-installation-id",
    "allow-update-general-settings",
    "allow-enable-sync",
    "allow-disable-sync",
    "allow-sync-now",
    "allow-sync-queue-status",
    "allow-backup-status",
    "allow-backup-now",
    "allow-set-backup-enabled",
    "allow-export-transaction-archive",
    "allow-list-transaction-archives",
    "allow-download-transaction-archive",
    "allow-download-transaction-archive-pdf"
  ]
}
